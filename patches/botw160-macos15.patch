+// 把 `[e barrierAfterQueueStages:... beforeStages:... visibilityOptions:...]`
+// 整句换成空操作（供 sed 化改写使用）
+// Turn a whole `[e barrierAfter... beforeStages:... visibilityOptions:...]` sentence into a no-op.
+#define M3_BARRIER_DROP(...) ((void)0)
